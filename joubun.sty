%--------------------------------sakujotext
%-------見出しの種類ごとの関数の設定
% #1 = 種類, #2 = 上の空き, #3 = 字下げ, #4 = 見出しの整形
\newcommand{\DeclareSakujoTextType}[4]{%
  \expandafter\def\csname sakujotext@vskip@#1\endcsname{#2}%
  \expandafter\def\csname sakujotext@hspace@#1\endcsname{#3}%
  \expandafter\def\csname sakujotext@format@#1\endcsname##1{#4{##1}}%
}

%-------通常と太字の設定
\newcommand{\sakujotext@plain}[1]{#1}
\newcommand{\sakujotext@bold}[1]{{\bizudgb #1}}

%-------種類ごとの設定
%---条
\DeclareSakujoTextType{jou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edajou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{eda2jou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{eda3jou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
%---項
\DeclareSakujoTextType{kou}{0\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edakou}{0\myzw}{0\myzw}{\sakujotext@bold}
%---号
\DeclareSakujoTextType{gou}{0\myzw}{1\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edagou}{0\myzw}{1\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{eda2gou}{0\myzw}{1\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{eda3gou}{0\myzw}{1\myzw}{\sakujotext@bold}
%---編
\DeclareSakujoTextType{hen}{1\myzw}{2\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edahen}{1\myzw}{2\myzw}{\sakujotext@plain}
%---章
\DeclareSakujoTextType{syou}{1\myzw}{3\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edasyou}{1\myzw}{3\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda2syou}{1\myzw}{3\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda3syou}{1\myzw}{3\myzw}{\sakujotext@plain}
%---節
\DeclareSakujoTextType{setu}{1\myzw}{4\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edasetu}{1\myzw}{4\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda2setu}{1\myzw}{4\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda3setu}{1\myzw}{4\myzw}{\sakujotext@plain}
%---款
\DeclareSakujoTextType{kan}{1\myzw}{5\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edakan}{1\myzw}{5\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda2kan}{1\myzw}{5\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda3kan}{1\myzw}{5\myzw}{\sakujotext@plain}
%---目
\DeclareSakujoTextType{moku}{1\myzw}{6\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edamoku}{1\myzw}{6\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda2moku}{1\myzw}{6\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{eda3moku}{1\myzw}{6\myzw}{\sakujotext@plain}

%-------\sakujotextの定義
\newcommand{\sakujotext}[3][]{%
  \par
  \@ifundefined{sakujotext@vskip@#1}{%
    \vskip 1\myzw
    \noindent #2%
  }{%
    \vskip \csname sakujotext@vskip@#1\endcsname
    \noindent
    \hspace{\csname sakujotext@hspace@#1\endcsname}%
    \csname sakujotext@format@#1\endcsname{#2}%
  }%
  \hskip 1\myzw #3\par
}

