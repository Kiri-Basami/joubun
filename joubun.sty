%--------------------------------sakujotext
%-------見出しの種類ごとの関数の設定
% #1 = 種類, #2 = 上の空き, #3 = 字下げ, #4 = 見出しの整形
\newcommand{\DeclareSakujoTextType}[4]{%
  \expandafter\def\csname sakujotext@vskip@#1\endcsname{#2}%
  \expandafter\def\csname sakujotext@hspace@#1\endcsname{#3}%
  \expandafter\def\csname sakujotext@format@#1\endcsname##1{#4{##1}}%
}

%-------通常と太字の設定
\newcommand{\sakujotext@plain}[1]{#1}
\newcommand{\sakujotext@bold}[1]{{\provisionfont #1}}

%-------種類ごとの設定
%---条
\DeclareSakujoTextType{jou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edajou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIjou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIIjou}{0.5\myzw}{0\myzw}{\sakujotext@bold}
%---項
\DeclareSakujoTextType{kou}{0\myzw}{0\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edakou}{0\myzw}{0\myzw}{\sakujotext@plain}
%---号
\DeclareSakujoTextType{gou}{0\myzw}{1\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edagou}{0\myzw}{1\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edaIIgou}{0\myzw}{1\myzw}{\sakujotext@plain}
\DeclareSakujoTextType{edaIIIgou}{0\myzw}{1\myzw}{\sakujotext@plain}
%---編
\DeclareSakujoTextType{hen}{1\myzw}{2\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edahen}{1\myzw}{2\myzw}{\sakujotext@bold}
%---章
\DeclareSakujoTextType{syou}{1\myzw}{3\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edasyou}{1\myzw}{3\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIsyou}{1\myzw}{3\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIIsyou}{1\myzw}{3\myzw}{\sakujotext@bold}
%---節
\DeclareSakujoTextType{setu}{1\myzw}{4\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edasetu}{1\myzw}{4\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIsetu}{1\myzw}{4\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIIsetu}{1\myzw}{4\myzw}{\sakujotext@bold}
%---款
\DeclareSakujoTextType{kan}{1\myzw}{5\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edakan}{1\myzw}{5\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIkan}{1\myzw}{5\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIIkan}{1\myzw}{5\myzw}{\sakujotext@bold}
%---目
\DeclareSakujoTextType{moku}{1\myzw}{6\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edamoku}{1\myzw}{6\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIImoku}{1\myzw}{6\myzw}{\sakujotext@bold}
\DeclareSakujoTextType{edaIIImoku}{1\myzw}{6\myzw}{\sakujotext@bold}

%-------\sakujotextの定義
\newcommand{\sakujotext}[3][]{%
  \par
  \@ifundefined{sakujotext@vskip@#1}{%
    \vskip 1\myzw
    \noindent #2%
  }{%
    \vskip \csname sakujotext@vskip@#1\endcsname
    \noindent
    \hspace{\csname sakujotext@hspace@#1\endcsname}%
    \csname sakujotext@format@#1\endcsname{#2}%
  }%
  \hskip 1\myzw #3\par
}

